{
    "name": "katsana/katsana-sdk-laravel",
    "description": "KATSANA SDK for Laravel",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "KATSANA Developer",
            "email": "developer@katsana.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Katsana\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Katsana\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "katsana/katsana-sdk-php": "dev-master",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.2-dev"
        },
        "laravel": {
            "providers": [
                "Katsana\\ServiceProvider"
            ],
            "aliases": {
                "Katsana": "Katsana\\Katsana"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev"
}
